# TERRA-X environment template. Copy to .env and fill only what you need.
# The core scientific workflow (DEM + land-cover analogue search) runs with no credentials.

TERRAX_ENV=development
TERRAX_LOG_LEVEL=INFO

# PostgreSQL/PostGIS. Docker Compose exposes 5434; change if that port is busy.
DATABASE_URL=postgresql+psycopg://terrax:terrax@localhost:5434/terrax
POSTGRES_DB=terrax
POSTGRES_USER=terrax
POSTGRES_PASSWORD=terrax

# Public API + frontend
TERRAX_API_BASE_URL=http://localhost:8000
TERRAX_PUBLIC_API_URL=http://localhost:8000
TERRAX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Optional override. Local origins on any port are allowed by default.
# TERRAX_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local cache for downloaded scientific products (not committed).
TERRAX_DATA_DIR=./data
TERRAX_CACHE_DIR=./data/cache
TERRAX_REPORT_DIR=./data/reports

# Optional: NASA Earthdata Login (EDL) bearer token.
# Create one at https://urs.earthdata.nasa.gov/profile (Generate Token).
# Needed only for authenticated products such as MODIS/VIIRS LST, SMAP, GPM granules.
NASA_EARTHDATA_TOKEN=

# Optional: NASA FIRMS MAP_KEY (https://firms.modaps.eosdis.nasa.gov/api/area/)
NASA_FIRMS_MAP_KEY=

# Optional: LLM research assistant. The core platform works without any LLM.
# provider: none | openai | anthropic | ollama
TERRAX_LLM_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
TERRAX_LLM_MODEL=

# Optional: protect data-refresh/admin endpoints. If empty, they are disabled unless
# TERRAX_ALLOW_ANONYMOUS_ADMIN=true.
TERRAX_ADMIN_API_KEY=

# Rate limit per client per minute (in-process; use Redis at larger scale).
TERRAX_RATE_LIMIT_PER_MINUTE=120

# Nominatim reverse geocoding. Use an identifying contact string.
TERRAX_GAZETTEER_USER_AGENT=TERRA-X/0.1 (planetary analogue research; contact: local)

# Worker
TERRAX_WORKER_POLL_SECONDS=1.0
TERRAX_JOB_MAX_ATTEMPTS=3

# Optional Redis (cache/coordination). The default job queue uses PostgreSQL.
REDIS_URL=redis://localhost:6379/0
